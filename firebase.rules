rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserRole(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && (
        getUserRole(request.auth.uid) == 'admin' ||
        request.auth.token.email == 'andrii.disha@gmail.com'
      );
    }

    function isHost() {
      return isSignedIn() && getUserRole(request.auth.uid) == 'host';
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update, delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /properties/{propertyId} {
      allow read: if true;
      allow create: if isHost() || isAdmin();
      allow update, delete: if isSignedIn() && (resource.data.hostId == request.auth.uid || isAdmin());
    }

    match /bookings/{bookingId} {
      allow create: if isSignedIn() && request.resource.data.clientId == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.clientId == request.auth.uid || resource.data.hostId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (resource.data.clientId == request.auth.uid || resource.data.hostId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /bookingAvailability/{bookingId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.clientId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.hostId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /expenses/{expenseId} {
      allow read: if isSignedIn() && (
        resource.data.hostId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.hostId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isSignedIn() && (
        resource.data.hostId == request.auth.uid ||
        request.resource.data.hostId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (
        resource.data.hostId == request.auth.uid ||
        isAdmin()
      );
    }

    match /cleaningTickets/{ticketId} {
      allow read: if isSignedIn() && (
        resource.data.hostId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.hostId == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if isSignedIn() && (
        resource.data.hostId == request.auth.uid ||
        isAdmin()
      );
    }

    match /fixedAssets/{assetId} {
      allow read: if isSignedIn() && (
        resource.data.hostId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.hostId == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if isSignedIn() && (
        resource.data.hostId == request.auth.uid ||
        isAdmin()
      );
    }
  }
}
